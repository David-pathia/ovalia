# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Adresse publique de l'application (liens dans les mails Supabase)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA (côté serveur uniquement, type Secret sur Vercel)
ANTHROPIC_API_KEY=
# Seulement si la clé n’est pas rattachée à un espace de travail (sk-ant-usr-…)
ANTHROPIC_WORKSPACE_ID=
